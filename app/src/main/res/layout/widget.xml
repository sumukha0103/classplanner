<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/w_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/w_accent"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_classes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="7"
        android:textColor="@color/w_ink"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/w_r1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_n1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_ink" android:textSize="13sp" />
        <TextView android:id="@+id/w_a1" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_ok" android:gravity="center" android:text="✓" android:textColor="@color/w_ok" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m1" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_no" android:gravity="center" android:text="✗" android:textColor="@color/w_bad" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_s1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_n2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_ink" android:textSize="13sp" />
        <TextView android:id="@+id/w_a2" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_ok" android:gravity="center" android:text="✓" android:textColor="@color/w_ok" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m2" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_no" android:gravity="center" android:text="✗" android:textColor="@color/w_bad" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_s2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_n3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_ink" android:textSize="13sp" />
        <TextView android:id="@+id/w_a3" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_ok" android:gravity="center" android:text="✓" android:textColor="@color/w_ok" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m3" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_no" android:gravity="center" android:text="✗" android:textColor="@color/w_bad" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_s3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_n4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_ink" android:textSize="13sp" />
        <TextView android:id="@+id/w_a4" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_ok" android:gravity="center" android:text="✓" android:textColor="@color/w_ok" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m4" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_no" android:gravity="center" android:text="✗" android:textColor="@color/w_bad" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_s4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/w_r5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView android:id="@+id/w_n5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:ellipsize="end" android:maxLines="1" android:textColor="@color/w_ink" android:textSize="13sp" />
        <TextView android:id="@+id/w_a5" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_ok" android:gravity="center" android:text="✓" android:textColor="@color/w_ok" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_m5" android:layout_width="30dp" android:layout_height="30dp" android:layout_marginStart="6dp" android:background="@drawable/w_btn_no" android:gravity="center" android:text="✗" android:textColor="@color/w_bad" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_s5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/w_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/w_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/w_due"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="4"
        android:textColor="@color/w_bad"
        android:textSize="12sp" />
</LinearLayout>
